// ===== MAIN ===========
// =====================

int main() {

    // ===== Test Problem 6.1 =====
    Person arr[] = {
        {"An", "Nguyen", 22},
        {"Binh", "Tran", 19},
        {"Cuong", "Le", 25},
        {"Dung", "Pham", 18}
    };

    int n = sizeof(arr)/sizeof(arr[0]);

    printf("Sort theo firstname:\n");
    qsort(arr, n, sizeof(Person), cmp_firstname);
    for (int i = 0; i < n; i++)
        printf("%s %s %d\n", arr[i].firstname, arr[i].lastname, arr[i].age);

    printf("\nSort theo lastname:\n");
    qsort(arr, n, sizeof(Person), cmp_lastname);
    for (int i = 0; i < n; i++)
        printf("%s %s %d\n", arr[i].firstname, arr[i].lastname, arr[i].age);

    printf("\nNguoi > 20 tuoi:\n");
    apply(arr, n, isolder);


    // ===== Test Problem 6.2 =====
    char *words[] = {"apple", "banana", "apple", "orange", "banana", "apple"};
    int m = 6;

    for (int i = 0; i < m; i++) {
        Node *n = lookup(words[i]);
        n->count++;
    }

    printf("\nWord frequency:\n");
    for (int i = 0; i < SIZE; i++) {
        Node *curr = table[i];
        while (curr != NULL) {
            printf("%s: %d\n", curr->word, curr->count);
            curr = curr->next;
        }
    }

    cleartable();

    return 0;
}
