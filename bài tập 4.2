// Struct cây
#include <stdio.h>
#include <stdlib.h>

struct tnode {
    int data;
    struct tnode* left;
    struct tnode* right;
};
// talloc — cấp phát node
struct tnode* talloc(int data) {
    struct tnode* node = (struct tnode*)malloc(sizeof(struct tnode));
    node->data = data;
    node->left = NULL;
    node->right = NULL;
    return node;
}
// addnode — insert BST
struct tnode* addnode(struct tnode* root, int data) {
    if (root == NULL) {
        return talloc(data);
    }

    if (data < root->data) {
        root->left = addnode(root->left, data);
    } else {
        root->right = addnode(root->right, data);
    }

    return root;
}
// preorder (NLR)
void preorder(struct tnode* root) {
    if (root != NULL) {
        printf("%d ", root->data);
        preorder(root->left);
        preorder(root->right);
    }
}
// inorder (LNR)
void inorder(struct tnode* root) {
    if (root != NULL) {
        inorder(root->left);
        printf("%d ", root->data);
        inorder(root->right);
    }
}
// deltree — xóa toàn bộ (post-order)
int deltree(struct tnode* root) {
    if (root == NULL) return 0;

    int count = 0;

    count += deltree(root->left);
    count += deltree(root->right);

    free(root);
    return count + 1;
}

